# Copie para .env (o setup.sh faz isso) e ajuste. NUNCA publique o .env (está no .gitignore).
HOST=192.168.1.10                # IP (ou nome) do servidor na rede; usado nos links do Homepage
DATA=/home/USUARIO/appdata       # configs dos containers
MEDIA=/home/USUARIO/media        # filmes, series, downloads (mesmo caminho em todos os apps, para hardlinks)
PUID=1000                        # id -u   (Podman rootless: use 0, que mapeia para o seu usuario)
PGID=1000                        # id -g   (Podman rootless: use 0)
TZ=America/Sao_Paulo
RENDER_GID=105                   # getent group render | cut -d: -f3   (so para aceleracao por GPU Intel)
HOMEPAGE_ALLOWED_HOSTS=192.168.1.10:8082   # IP:8082 do servidor (e outros nomes que usar para abrir o Homepage)
