# Copie para .env e ajuste. Não publique o .env (veja .gitignore).
DATA=/home/antony/appdata        # configs dos containers
MEDIA=/home/antony/media         # filmes, series, downloads (mesmo caminho em todos, para hardlinks)
PUID=1000                        # id -u   (em Podman rootless use 0 para mapear ao seu usuário)
PGID=1000                        # id -g
TZ=America/Sao_Paulo
RENDER_GID=105                   # getent group render | cut -d: -f3
HOMEPAGE_ALLOWED_HOSTS=192.168.1.205:8082
